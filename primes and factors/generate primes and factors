void generate_factors(int n , int i , vector<pi>&primes , set<int>&factors){
    if(i == primes.size()){
        factors.insert(n);
        return;
    }
    int a = 1;
    for(int j = 0 ; j <= primes[i].second ; j++ ){
        generate_factors(n*a,i+1,primes,factors);
        a*=primes[i].first;
    }
    return;
}
void generate_primes(int n , mii &mp){
    for(int i = 2 ; i*i <= n ;i++){
        if(n%i == 0){
            while(n%i == 0){
                mp[i]++;
                n/=i;
            }
        }
    }
    if(n!=1){
        mp[n]++;
    }
    return;
}
